<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PLUMA.UI.ConflictAlertPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Title="Manual resolution required"
    PrimaryButtonText="View conflict" SecondaryButtonText="Open folder" CloseButtonText="Close"
    DefaultButton="Close" PrimaryButtonClick="OnViewConflict" SecondaryButtonClick="OnOpenFolder">
    <StackPanel MaxWidth="440" MinWidth="0" Spacing="16">
        <local:PopupMessageText Text="PLUMA could not safely restore this file automatically."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock Text="Current path" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <local:PopupMessageText x:Name="CurrentPathText" Text="Downloads\quarterly report.pdf" />
            </StackPanel>
        </Border>
        <Border Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock Text="Conflict path" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <local:PopupMessageText x:Name="ConflictPathText" Text="Downloads\quarterly report.restored.pdf" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
