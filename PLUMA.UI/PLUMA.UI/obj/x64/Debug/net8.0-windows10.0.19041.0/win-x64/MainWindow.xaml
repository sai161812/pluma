<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PLUMA.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PLUMA">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Layout: integrated title bar (row 0) + content (row 1).
        The title bar element is registered as the draggable region in code-behind
        so the window keeps native caption buttons while providing an integrated
        area to show the app name subtly.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Integrated title bar area (draggable) -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,6" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Small, subtle application title shown in the title area. Uses theme fonts and brushes. -->
            <TextBlock Text="PLUMA" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        </Grid>

        <!-- Main app shell: NavigationView + Frame -->
        <NavigationView x:ConnectionId='3' x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="288"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        SelectionFollowsFocus="Disabled"
                                                         >

            <NavigationView.MenuItems>
                <NavigationViewItem x:ConnectionId='4' x:Name="DashboardNavItem" Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='5' x:Name="HistoryNavItem" Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:ConnectionId='6' x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>

