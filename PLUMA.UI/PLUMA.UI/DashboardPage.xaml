<Page
    x:Class="PLUMA.UI.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,24,28,32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="A clear view of what PLUMA is doing"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="PLUMA"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           CharacterSpacing="80" />
            </Grid>

            <Border Grid.Row="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Command entry"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               CharacterSpacing="40" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="CommandInput" PlaceholderText="Ask PLUMA to do something" IsEnabled="False"
                                    QuerySubmitted="OnCommandSubmitted" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Command text">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                        <Button x:Name="CommandRunButton" Grid.Column="1" Content="Run" IsEnabled="False" Click="OnRunCommand"
                                AutomationProperties.Name="Run command" />
                        <Button x:Name="CommandStopButton" Grid.Column="2" Content="Stop" IsEnabled="False" Click="OnStopCommand"
                                AutomationProperties.Name="Stop all PLUMA tasks" ToolTipService.ToolTip="Stop all PLUMA tasks" />
                    </Grid>
                    <TextBlock x:Name="CommandMessageText" Text="Connect to PLUMA to enter a command." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="CommandIdentityText" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="92"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Active task" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="TaskStateText" Text="Unavailable"
                                   FontSize="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        MinHeight="92"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current route" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="RouteText" Text="Unavailable"
                                   FontSize="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        MinHeight="92"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Core health" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button x:Name="CoreRefreshButton" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top"
                                Click="OnRefreshCore" IsEnabled="False" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="4"
                                AutomationProperties.Name="Refresh core connection" ToolTipService.ToolTip="Refresh core connection">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <TextBlock x:Name="CoreHealthText" Grid.Row="1" Text="Disconnected"
                                   FontSize="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Current activity"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="CurrentActivityList" IsHitTestVisible="False" SelectionMode="None" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Recent activity"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="RecentActivityList" IsItemClickEnabled="False" SelectionMode="None" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Live messages"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="LiveMessagesList" IsItemClickEnabled="False" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

</Page>
