<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.ToolCallCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Width="420"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border Padding="16,14,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />

                <local:PopupStatusIndicator x:Name="CallStatus" Grid.Column="1" Label="Unavailable" Kind="Dot"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <local:PopupMessageText Grid.Row="1"
                       x:Name="CallTool" Text="Tool unavailable"
                       FontFamily="Segoe UI Variable"
                       FontSize="18"
                       FontWeight="SemiBold" MaxHeight="96" />

            <Border Grid.Row="2"
                    Padding="10,8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                <local:PopupMessageText x:Name="CallArguments" Text="Arguments unavailable" PreserveLiteralText="True"
                           FontFamily="Segoe UI Variable"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CallElapsed" Text="Elapsed unavailable"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           x:Name="CallRisk" Text="Risk unavailable"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
