<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.RollbackPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="380"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border MinHeight="270"
            Padding="16,14,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <ProgressRing Width="14"
                                  Height="14"
                                  IsActive="True" />
                    <TextBlock Text="Rolling back"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="3">
                <TextBlock Text="Undoing recent changes"
                           FontFamily="Segoe UI Variable"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Step 2 of 3"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Height="3"
                         Value="66.7"
                         Maximum="100"
                         Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

            <StackPanel Grid.Row="3" Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Accept"
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="Closed temporary window"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="13"
                                  Height="13"
                                  IsActive="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Restoring quarterly_report.pdf"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{ThemeResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Restoring previous selection"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Text="Only verified reversible actions are restored."
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</UserControl>
