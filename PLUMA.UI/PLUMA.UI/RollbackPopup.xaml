<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.RollbackPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Width="380"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border MinHeight="270"
            Padding="16,14,16,16"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />

                <local:PopupStatusIndicator Grid.Column="1" Label="Rolling back" Kind="Progress"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="3">
                <TextBlock Text="Undoing recent changes"
                           FontFamily="Segoe UI Variable"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Step 2 of 3"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Height="3"
                         Value="66.7"
                         Maximum="100"
                         Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

            <StackPanel Grid.Row="3" Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Accept"
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <local:PopupMessageText Grid.Column="1"
                               Text="Closed temporary window"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="13"
                                  Height="13"
                                  IsActive="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    <local:PopupMessageText Grid.Column="1"
                               Text="Restoring quarterly report.pdf"
                               FontSize="12" MaxHeight="96" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{ThemeResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <local:PopupMessageText Grid.Column="1"
                               Text="Restoring previous selection"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
                </Grid>
            </StackPanel>

            <local:PopupMessageText Grid.Row="4"
                       Text="Only verified reversible actions are restored."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
        </Grid>
    </Border>
</UserControl>
