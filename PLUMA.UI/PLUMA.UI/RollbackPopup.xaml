<UserControl
    x:Class="PLUMA.UI.RollbackPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="RollbackAccentBrush" Color="#B86A6A" />
    </UserControl.Resources>

    <Border Width="360"
            MinHeight="260"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource RollbackAccentBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" />

            <Grid Grid.Column="1" Padding="16,14,16,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="PLUMA"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               CharacterSpacing="80" />
                    <TextBlock Grid.Column="1"
                               Text="ROLLBACK"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Rolling back…"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Step 2 of 3"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <ProgressBar Grid.Row="2"
                             Height="3"
                             Value="66.7"
                             Maximum="100"
                             Foreground="{StaticResource RollbackAccentBrush}"
                             Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                <StackPanel Grid.Row="3" Spacing="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="✓"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" />
                        <TextBlock Grid.Column="1"
                                   Text="Closed temporary window"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0"
                                      Width="12"
                                      Height="12"
                                      IsActive="True"
                                      Foreground="{StaticResource RollbackAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Restoring quarterly_report.pdf"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="○"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" />
                        <TextBlock Grid.Column="1"
                                   Text="Restoring previous selection"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Text="Safely undoing the recent action"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
