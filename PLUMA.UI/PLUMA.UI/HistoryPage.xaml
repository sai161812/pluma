<Page x:Class="PLUMA.UI.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PLUMA.UI">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" MaxWidth="1100" Padding="32,24,32,32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="History" Style="{StaticResource TitleTextBlockStyle}"/>
            <AutoSuggestBox x:Name="HistorySearch" Grid.Row="1" PlaceholderText="Search saved history"
                            HorizontalAlignment="Stretch" MaxWidth="720" QuerySubmitted="OnSearchSubmitted"/>
            <TextBlock x:Name="HistoryStatus" Grid.Row="2" Text="Refresh to read saved history."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ListView x:Name="HistoryRecords" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="False" BorderThickness="0"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryRow">
                        <Border Padding="0,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TaskId}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}" TextWrapping="Wrap" MaxWidth="160" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimestampText}" TextWrapping="Wrap" MaxWidth="180" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind CommandText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock Grid.Row="2" Text="{x:Bind MetadataText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                <Button x:Name="HistoryRefresh" Content="Refresh" Click="OnRefresh" IsEnabled="False"/>
                <Button x:Name="HistoryOlder" Content="Older tasks" Click="OnOlder" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
