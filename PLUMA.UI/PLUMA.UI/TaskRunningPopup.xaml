<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.TaskRunningPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Width="360"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border MinHeight="136"
            Padding="16,14,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <ProgressRing Width="14"
                                  Height="14"
                                  IsActive="True" />
                    <TextBlock Text="Running"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <local:PopupMessageText Grid.Row="1"
                       Text="Opening the latest PDF in Downloads"
                       FontSize="14" MaxHeight="96" />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <local:PopupMessageText Text="TASK-2025-0145"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
                <TextBlock Grid.Column="1"
                           Text="00:08"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
