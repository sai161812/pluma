<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.ToolResultCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Width="420"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border Padding="16,14,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />
                <local:PopupStatusIndicator Grid.Column="1" Label="Completed" Kind="Success"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4">
                <local:PopupMessageText Text="quarterly report.pdf opened successfully"
                           FontFamily="Segoe UI Variable"
                           FontSize="16"
                           FontWeight="SemiBold" MaxHeight="96" />
                <TextBlock Text="Tool · Open file"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:PopupStatusIndicator x:Name="VerificationState" Label="Verified" Kind="Success" />

                <local:PopupMessageText x:Name="ErrorCodeText"
                           Grid.Column="1"
                           Visibility="Collapsed"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
