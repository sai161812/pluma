<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.ToolResultCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    MinWidth="0"
    UseLayoutRounding="True">

    <Border Padding="16,14,16,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />
                <TextBlock Grid.Column="1"
                           Text="Completed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="quarterly_report.pdf opened successfully"
                           FontFamily="Segoe UI Variable"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="3" />
                <TextBlock Text="Tool · open_file"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="VerificationState"
                            Orientation="Horizontal"
                            Spacing="6">
                    <SymbolIcon x:Name="VerificationIcon"
                                Symbol="Accept"
                                Width="14"
                                Height="14" />
                    <TextBlock x:Name="VerificationText"
                               Text="Verified"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <TextBlock x:Name="ErrorCodeText"
                           Grid.Column="1"
                           Visibility="Collapsed"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
