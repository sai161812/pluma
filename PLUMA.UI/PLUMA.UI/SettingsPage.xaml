<Page
    x:Class="PLUMA.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  MaxWidth="1000"
                  Padding="32,24,32,32"
                  RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Settings"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="Local model"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Local llama.cpp planner and whisper.cpp speech runtime"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <controls:SettingsCard Header="Model path"
                                            Description="Local GGUF path. Native compatibility is verified when the model is used; saving requires restart."
                                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPath" Grid.Column="0"
                                     Text="Unavailable" TextChanged="OnFieldsChanged"
                                     HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Browse" IsEnabled="False" />
                        </Grid>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Maximum plan steps"
                                            Description="Whole number from 1 to 20. Saved changes require a Core restart."
                                            HorizontalAlignment="Stretch">
                        <NumberBox x:Name="PlanLimit" PlaceholderText="Unavailable"
                                   Minimum="1" Maximum="20" SmallChange="1"
                                   Width="240" HorizontalAlignment="Right" IsEnabled="False"
                                   ValueChanged="OnLimitChanged" AutomationProperties.Name="Maximum plan steps" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Text="Hotkeys"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Saved bindings. Conflicts are refused. Core restart is required to apply changes."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <controls:SettingsCard Header="Command activation"
                                                HorizontalAlignment="Stretch">
                            <TextBox x:Name="TextHotkey" Text="Unavailable" TextChanged="OnFieldsChanged"
                                     Width="240"
                                     HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Stop current task"
                                                HorizontalAlignment="Stretch">
                            <TextBox x:Name="StopHotkey" Text="Unavailable" TextChanged="OnFieldsChanged"
                                     Width="240"
                                     HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Voice activation hotkey" HorizontalAlignment="Stretch">
                            <TextBox x:Name="VoiceHotkey" Text="Unavailable" Width="240" TextChanged="OnFieldsChanged" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Global hotkey availability"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="HotkeyStatus" Text="Not verified" Width="240" TextWrapping="Wrap"
                                       HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8">
                    <TextBlock Text="Audio and voice"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Push-to-talk stays available. Wake listening and background capture are not enabled."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <controls:SettingsCard Header="Configured voice activation"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="VoiceMode" Text="Unavailable" Width="240" TextWrapping="Wrap"
                                       HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Speech model path"
                                                HorizontalAlignment="Stretch">
                            <TextBox x:Name="SpeechModelPath" Text="Unavailable" TextChanged="OnFieldsChanged"
                                     Width="240" HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Include command previews in logs" Description="Off hides text and speech previews from logs. Factual Activity history remains available." HorizontalAlignment="Stretch">
                            <ToggleSwitch x:Name="CommandPreviews" Toggled="OnWarmChanged" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Diagnostic logging" Description="Verbose local diagnostics after restart. Sensitive values remain redacted; no raw audio or screenshots are saved." HorizontalAlignment="Stretch">
                            <ToggleSwitch x:Name="DiagnosticLogging" Toggled="OnWarmChanged" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Privacy defaults"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="PrivacyDefaults" Text="Unavailable" Width="240" TextWrapping="Wrap"
                                       HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="8">
                    <TextBlock Text="Tool permissions"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Policy is evaluated for each exact action. Safety protections cannot be disabled."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <controls:SettingsCard Header="Read files and folders"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="ReadPolicy" Text="Unavailable" Width="240"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Modify files and folders"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="WritePolicy" Text="Unavailable" Width="240"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Confirm low-risk changes" Description="Adds material confirmation to low-risk changes. Required high-risk and administrator protections remain enforced." HorizontalAlignment="Stretch">
                            <ToggleSwitch x:Name="ConfirmLowRisk" Toggled="OnWarmChanged" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="High-risk confirmation"
                                                HorizontalAlignment="Stretch">
                            <TextBlock x:Name="HighRiskPolicy" Text="Unavailable" Width="240"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="8">
                    <controls:SettingsCard Header="Model unload delay" Description="Upper bound in seconds, from 0 to 30. Task-owned native models release after every request." HorizontalAlignment="Stretch">
                        <NumberBox x:Name="ModelGrace" Minimum="0" Maximum="30" Width="240" ValueChanged="OnGraceChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Speech unload delay" Description="Upper bound in seconds, from 0 to 30. Task-owned speech models release after every request." HorizontalAlignment="Stretch">
                        <NumberBox x:Name="SpeechGrace" Minimum="0" Maximum="30" Width="240" ValueChanged="OnGraceChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="OCR unload delay" Description="Upper bound in seconds, from 0 to 30. Current OCR workers release on completion." HorizontalAlignment="Stretch">
                        <NumberBox x:Name="OcrGrace" Minimum="0" Maximum="30" Width="240" ValueChanged="OnGraceChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Allow short warm grace" Description="No model is kept warm without measured benefit. Off requires immediate release." HorizontalAlignment="Stretch">
                        <ToggleSwitch x:Name="WarmGrace" Toggled="OnWarmChanged" />
                    </controls:SettingsCard>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SettingsSave" Content="Save settings" IsEnabled="False" Click="OnSave" />
                        <Button x:Name="SettingsCancel" Content="Cancel edits" IsEnabled="False" Click="OnCancel" />
                        <Button x:Name="SettingsReload" Content="Reload" IsEnabled="False" Click="OnReload" />
                        <Button x:Name="SettingsRecover" Content="Restore previous settings" IsEnabled="False" Click="OnRecover" />
                        <Button x:Name="SettingsStop" Content="STOP" IsEnabled="False" Click="OnStop" />
                    </StackPanel>
                    <TextBlock x:Name="SettingsStatus" Text="Connect to Core to read settings."
                               TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock x:Name="SettingsCommandStatus" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>