<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.OcrMatchIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    UseLayoutRounding="True" IsHitTestVisible="False" Visibility="Collapsed">
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="TargetOutline" BorderThickness="2" CornerRadius="4"
                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" />
        <Border x:Name="MatchCallout" Width="320" Padding="16,14" CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="5">
                <TextBlock Text="Text match" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <local:PopupMessageText x:Name="MatchText" FontFamily="Segoe UI Variable" FontSize="16"
                           FontWeight="SemiBold" MaxHeight="96" />
                <local:PopupMessageText x:Name="MetadataText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
