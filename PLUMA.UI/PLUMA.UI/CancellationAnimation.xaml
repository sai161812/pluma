<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.CancellationAnimation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PLUMA.UI"
    Width="360"
    MinWidth="0"
    MinHeight="140"
    Visibility="Collapsed"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.16" />
        </Storyboard>
        <Storyboard x:Name="FadeOutStoryboard"
                    Completed="OnFadeOutCompleted">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.16" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            MinHeight="140"
            Padding="16,14,16,16"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="PLUMA" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           CharacterSpacing="80" />

                <local:PopupStatusIndicator Grid.Column="1" Label="Stopping" Kind="Progress"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <local:PopupMessageText x:Name="HeadingText"
                       Grid.Row="1"
                       FontFamily="Segoe UI Variable"
                       FontSize="17"
                       FontWeight="SemiBold" MaxHeight="96" />

            <local:PopupMessageText x:Name="MessageText"
                       Grid.Row="2"
                       FontFamily="Segoe UI Variable"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />

            <local:PopupMessageText x:Name="MetadataText"
                       Grid.Row="3"
                       FontFamily="Segoe UI Variable"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxHeight="96" />
        </Grid>
    </Border>
</UserControl>
