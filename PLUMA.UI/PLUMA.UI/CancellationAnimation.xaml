<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PLUMA.UI.CancellationAnimation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    MinHeight="140"
    Visibility="Collapsed">

    <UserControl.Resources>
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
        </Storyboard>
        <Storyboard x:Name="FadeOutStoryboard" Completed="OnFadeOutCompleted">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid MinHeight="140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B86A6A" CornerRadius="2,0,0,2" />

            <Grid Grid.Column="1" Padding="16,13,16,14" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        Text="PLUMA"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        CharacterSpacing="80" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Fill="#B86A6A" />
                </Grid>

                <TextBlock
                    x:Name="HeadingText"
                    Grid.Row="1"
                    FontFamily="Segoe UI Variable"
                    FontSize="17"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="MessageText"
                    Grid.Row="2"
                    FontFamily="Segoe UI Variable"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="MetadataText"
                    Grid.Row="3"
                    FontFamily="Segoe UI Variable"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
